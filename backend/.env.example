# Copy to .env and fill in. .env is gitignored; never commit real values.
GEMINI_API_KEY=
# Optional: defaults to gemini-3.5-flash-lite. gemini-3.8-flash is stronger but slower.
GEMINI_MODEL=
# Optional: the stronger model used by the 'strong' reasoning modes.
GEMINI_MODEL_STRONG=

# OAuth sign-in for the HTTP API (src/oauth/). Google by default: create an OAuth
# client ("Web application") and add OAUTH_REDIRECT_URI as an authorised redirect URI.
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
# Optional: defaults to http://localhost:8000/oauth/callback
OAUTH_REDIRECT_URI=
# Optional: where the browser goes after signing in (otherwise /oauth/callback returns JSON)
OAUTH_POST_LOGIN_REDIRECT=
# Optional: set to false only when testing over plain http on a host browsers won't
# treat as secure; session cookies are Secure by default.
OAUTH_COOKIE_SECURE=
# Optional, for a provider other than Google: OAUTH_AUTHORIZE_URL, OAUTH_TOKEN_URL,
# OAUTH_USERINFO_URL, OAUTH_SCOPES (default "openid email profile").
# Optional PostgreSQL/Tiger Data connection URI, required only for --database and migrations.
# Include the TLS setting supplied by Tiger Data (for example, sslmode=require).
DATABASE_URL=
# Optional Snowflake vector retrieval (src/snowflake_rag/). Leave RAG_BACKEND empty for
# PostgreSQL keyword search only; set it to snowflake after `python -m snowflake_rag setup`
# and `sync`. Key-pair auth: SNOWFLAKE_PRIVATE_KEY_FILE is a path to a .p8 key kept outside the repo.
RAG_BACKEND=
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PRIVATE_KEY_FILE=
# Optional: only if the private key is encrypted.
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=
# Optional: defaults to the user's default role.
SNOWFLAKE_ROLE=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=
# Optional: defaults to snowflake-arctic-embed-l-v2.0 (1024 dimensions). Changing it re-syncs every chunk.
SNOWFLAKE_EMBED_MODEL=
# Optional SEC filings and 8-K press releases: identify your application and a real contact email (not an API key).
SEC_USER_AGENT=
# Optional local frontend origins, comma-separated. Default localhost:5173 and localhost:3000.
API_CORS_ORIGINS=
